PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/recipe-planner
JWT_SECRET=replace_with_a_long_random_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Recipe generation + photo recognition (OpenRouter) — get a free key at
# https://openrouter.ai/keys. Both features share this one key.
OPENROUTER_API_KEY=your_openrouter_key_here
# "openrouter/free" auto-picks from whatever free models are currently
# available, so it won't silently break when a specific :free model gets
# pulled. Set to a specific model ID (e.g. "meta-llama/llama-3.3-70b-instruct:free")
# if you want to pin one instead — check https://openrouter.ai/models?max_price=0 for options.
OPENROUTER_MODEL=openrouter/free
# Vision (photo recognition) needs a model that actually accepts images —
# "openrouter/free" doesn't reliably route to one. Free vision-capable model
# IDs also rotate — check https://openrouter.ai/models?modality=text%2Bimage-%3Etext&max_price=0
# if the default stops working.
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
# Optional — OpenRouter uses these to attribute traffic on their leaderboards. Safe to leave unset.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Just In Time
